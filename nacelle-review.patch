+#!/usr/bin/env node
+/**
+ * Static release guard for two Nacelle+ invariants that are easy to regress:
+ *  1. enabling privileged transport must not silently force page-realm execution;
+ *  2. native fetch failures must not trigger replay of unsafe methods through Nacelle+.
+ *
+ * This is deliberately conservative. A hit requires a human review or an inline
+ * `nacelle-plus-safety-reviewed` annotation explaining why the code is safe.
+ */
+import { readdir, readFile } from 'node:fs/promises';
+import { extname, join, relative } from 'node:path';
+
+const root = new URL('..', import.meta.url).pathname;
+const ignored = new Set(['node_modules', '.git', 'dist', 'build', 'coverage']);
+const extensions = new Set(['.ts', '.tsx', '.js', '.jsx', '.mjs', '.cjs']);
+const failures = [];
+
+async function walk(dir) {
+  for (const entry of await readdir(dir, { withFileTypes: true })) {
+    if (ignored.has(entry.name)) continue;
+    const path = join(dir, entry.name);
+    if (entry.isDirectory()) await walk(path);
+    else if (extensions.has(extname(path))) await inspect(path);
+  }
+}
+
+async function inspect(path) {
+  if (path === new URL(import.meta.url).pathname) return;
+  const source = await readFile(path, 'utf8');
+  if (!/nacelle.?plus|extension transport/i.test(source)) return;
+  const lines = source.split(/\r?\n/);
+  for (let i = 0; i < lines.length; i++) {
+    const window = lines.slice(Math.max(0, i - 10), i + 11).join('\n');
+    if (/nacelle-plus-safety-reviewed/.test(window)) continue;
+    if (/nacelle.?plus/i.test(window) && /(worker|isolation|realm)/i.test(window) && /(?:=|:)\s*false|page.?realm|main.?thread/i.test(window)) {
+      failures.push(`${relative(root, path)}:${i + 1}: Nacelle+ may weaken worker isolation`);
+    }
+    if (/catch\s*\(/.test(lines[i]) && /\bfetch\s*\(/.test(window) && /(nacelle.?plus|extension|fallback)/i.test(window) && !/(GET|HEAD|idempotent|replay.?safe|selectTransport)/i.test(window)) {
+      failures.push(`${relative(root, path)}:${i + 1}: native fetch fallback may replay an unsafe request`);
+    }
+  }
+}
+
+await walk(root);
+if (failures.length) {
+  console.error('Nacelle+ safety invariant check failed:\n' + failures.map(x => `- ${x}`).join('\n'));
+  process.exitCode = 1;
+}
